# Copy to .env.local and fill in. NEVER commit .env.local
# Supabase > Connect > Transaction pooler (port 6543). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
